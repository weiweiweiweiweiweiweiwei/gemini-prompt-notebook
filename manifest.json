{
  "manifest_version": 3,
  "name": "Gemini 常用提示詞筆記本",
  "version": "4.5.0",
  "description": "在 Gemini、ChatGPT、Claude 的輸入框工具列加入原生風格的「常用提示詞」按鈕，點一下就能把常用 Prompt 填進輸入框。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["src/store.js", "src/share.js", "src/cloud-config.js", "src/cloud-ext.js", "src/panel.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://weiweiweiweiweiweiweiwei.github.io/gemini-prompt-notebook/ext-login.html*"],
      "js": ["src/ext-login.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "常用提示詞"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
